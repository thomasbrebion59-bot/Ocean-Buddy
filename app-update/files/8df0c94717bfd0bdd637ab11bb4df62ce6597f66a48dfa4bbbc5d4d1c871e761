/* Transitions d'activité (activity-transition.js) : voile uni, nom de l’activité en petit, sans illustration. */
.act-tr{position:fixed;inset:0;z-index:3000;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0B1F4D;color:#fff;opacity:0;touch-action:none;user-select:none;-webkit-user-select:none}
.act-tr-cap{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 32px;opacity:0}
.act-tr-eyebrow{font:600 11px/1 var(--body,system-ui);letter-spacing:.2em;text-transform:uppercase;opacity:.55}
.act-tr-title{margin-top:14px;font:700 34px/1.1 var(--body,system-ui);letter-spacing:-.01em;color:#fff}
.act-tr-rule{display:block;margin:18px 0 14px;width:56px;height:2px;border-radius:2px;background:var(--a,#7FB2FF);transform:scaleX(0)}
.act-tr-count{font:500 14px/1.3 var(--body,system-ui);opacity:.7}

/* En-tête du choix de destination aux couleurs de l’activité choisie. */
.ocean-v2 #spotsTop[data-act]:not([data-act=""]){position:relative;isolation:isolate;overflow:hidden;margin-bottom:18px;padding:26px 22px 20px!important;border-radius:26px;color:#fff;
  background:linear-gradient(180deg,rgba(6,21,47,.1) 0%,rgba(6,21,47,.62) 100%),var(--act-scene) center 40%/cover no-repeat;box-shadow:0 20px 44px -26px rgba(11,45,122,.7);animation:act-hero .6s cubic-bezier(.2,.8,.2,1)}
.ocean-v2 #spotsTop[data-act]:not([data-act=""]) h1,.ocean-v2 #spotsTop[data-act]:not([data-act=""]) h1 span{color:#fff!important;text-shadow:0 3px 18px rgba(2,7,17,.45)}
.ocean-v2 #spotsTop[data-act]:not([data-act=""]) h1 span{color:#d7f75b!important}
.ocean-v2 #spotsTop[data-act]:not([data-act=""]) .sub{color:rgba(255,255,255,.92)!important}
@keyframes act-hero{from{background-position:center 55%;opacity:.4}}
.reduce-motion #spotsTop[data-act]{animation:none}
.ocean-v2 #spotsTop[data-act]:not([data-act=""]) .page-eyebrow{color:#d7f75b!important;opacity:1}

::view-transition-old(root),::view-transition-new(root){animation-duration:.42s;animation-timing-function:cubic-bezier(.2,.8,.2,1)}

