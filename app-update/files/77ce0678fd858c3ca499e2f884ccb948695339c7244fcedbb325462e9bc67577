<script>/* Rideau de démarrage : un seul écran stable (identique au splash natif) jusqu’à ce que l’accueil soit prêt.
   Contrat (vérifié par npm run check:boot) : html.ob-booting, #obBoot, window.OceanBoot {t0, lifted, liftedAt, reason, ready()},
   événement window « ocean:home-ready » ; levée forcée 4000 ms après t0. Le rideau ne retarde jamais appReady(). */
(function(){var d=document.documentElement,B;
try{if(window.Capacitor||location.protocol==='capacitor:')d.classList.add('native-app');}catch(e){}
d.classList.add('ob-booting');
B=window.OceanBoot={t0:performance.now(),lifted:false,liftedAt:null,reason:null,steps:{},
  /* Onboarding terminé : drapeau explicite, ou profil existant qui a déjà une activité ou un niveau (règle partagée avec app.js). */
  onboarded:function(s){return !!s&&typeof s==='object'&&(s.onboarded===true||!!s.level||!!s.sport);},
  /* Étapes attendues avant la levée (« shell » : app-shell.js ; « feed » : montage définitif de home-feed.js) ; wait() réarme une étape. */
  wait:function(k){if(!B.lifted)B.steps[k]=false;},
  done:function(k){B.steps[k]=true;for(var s in B.steps)if(!B.steps[s])return;B.ready('ready');},
  after:function(f){if(B.lifted)setTimeout(f,0);else addEventListener('ocean:home-ready',function(){f();},{once:true});},
  ready:function(reason){
    if(B.lifted)return;
    B.lifted=true;B.liftedAt=performance.now();B.reason=reason==='timeout'?'timeout':'ready';clearTimeout(B.cap);
    d.classList.remove('ob-booting');
    /* L’accueil se peint d’abord sous le rideau encore opaque (deux images), puis un seul fondu de 220 ms. */
    var c=document.getElementById('obBoot');
    if(c)requestAnimationFrame(function(){requestAnimationFrame(function(){c.classList.add('is-out');setTimeout(function(){if(c.parentNode)c.parentNode.removeChild(c);},260);});});
    try{dispatchEvent(new CustomEvent('ocean:home-ready',{detail:{reason:B.reason}}));}catch(e){}
  }};
try{if(B.onboarded(JSON.parse(localStorage.getItem('oceanbuddy_v1')||'null')))d.classList.add('ob-onboarded');}catch(e){}
B.wait('shell');B.wait('feed');
B.cap=setTimeout(function(){B.ready('timeout');},4000);
/* Fond d’ambiance de l’accueil (élément LCP) : photo du spot de rêve du jour (même rotation que heroSpots() de home-feed.js),
   demandée tout de suite (preload) puis posée sur l’image statique de #home dès que l’analyseur l’atteint, sans attendre les scripts ;
   home-feed.js reprend ce fond et la première photo du carrousel est la même URL. Liste générée par scripts/build-home-ambient.py. */
var A=/*ambient*/[['rajaampat','assets/spots/rajaampat.jpg'],['borabora','assets/spots/borabora.jpg'],['noronha','assets/spots/noronha.jpg'],['navagio','assets/spots/navagio.jpg'],['whitehaven','assets/spots/whitehaven.jpg'],['macarella','assets/spots/macarella.webp'],['tikehau','assets/spots/tikehau.webp'],['myrtos','assets/spots/myrtos.webp'],['nusapenida','assets/spots/nusapenida.webp'],['trunkbay','assets/spots/trunkbay.webp'],['pelosa','assets/spots/pelosa.webp'],['losroques','assets/spots/losroques.webp']]/*/ambient*/,mo;
