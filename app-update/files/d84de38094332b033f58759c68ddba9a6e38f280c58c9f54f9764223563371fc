keylargo":{"n":"Key Largo","f":[["La Key lime pie","Tarta de lima de los Keys, con leche condensada azucarada; es la tarta oficial de Florida desde 2006."],["La minitemporada de la langosta","En julio, la minitemporada de la langosta abre dos días en los Keys (el 29 y el 30 en 2026)."],["El parque Pennekamp","Abierto en 1963, es el primer parque submarino de Estados Unidos; la estatua Christ of the Abyss reposa allí a casi 8 m de profundidad."],["Los Conchs","Los habitantes de los Keys se llamaron durante mucho tiempo «Conchs»; Key West incluso proclamó su «República» el 23 de abril de 1982."]]},"es-galice-razo":{"n":"Razo y Carballo","f":[["El polbo á feira","Pulpo hervido en una olla de cobre, luego espolvoreado con sal gruesa y pimentón, y regado con aceite de oliva."],["La queimada","Ponche de aguardiente de orujo, azúcar y cortezas, flambeado mientras se recita un conjuro para ahuyentar a los malos espíritus."],["La noche de San Juan","El 23 de junio, noche de las brujas en Galicia: es el momento en que se prepara sobre todo la queimada."],["La morriña","Palabra gallega para la melancolía que se siente lejos de la tierra donde uno nació."],["La feira de Carballo","En Carballo, el mercado de productos agrícolas se celebra los jueves, y los domingos 2.º, 4.º y 5.º del mes."]]},"co-sanandres":{"n":"San Andrés","f":[["El rondón","Guiso de pescado o de caracol de mar, yuca, plátano y fruto del árbol del pan, cocido en leche de coco."],["La veda del cangrejo negro","Cada año, del 1 de abril al 31 de julio, está prohibida la caza del cangrejo negro, porque la especie está amenazada."],["El criollo raizal","Los raizales, comunidad afrocaribeña de las islas, hablan el criollo de San Andrés y Providencia, además de español e inglés."]]},"nz-coromandel-cathedralcove":{"n":"Cathedral Cove y Mercury Bay","f":[["Te Whanganui-A-Hei","El nombre maorí del lugar significa «la gran bahía de Hei», por un tohunga de la canoa Te Arawa."],["El hāngī","Cocina maorí en horno de tierra: carne, verduras y mariscos se cuecen sobre piedras ardientes enterradas."],["El Whitianga Oceans Festival","Cada septiembre, Whitianga celebra los mariscos de Coromandel (el 14 de septiembre en 2024)."],["Matariki","Año Nuevo maorí, con la salida de las Pléyades, festivo desde 2022: el 10 de julio de 2026 y luego el 25 de junio de 2027."],["Hot Water Beach","Dos horas en torno a la marea baja, se cava la arena para hacer brotar agua caliente, de hasta 64 °C."]]},"nl-la-haye-scheveningen":{"n":"Scheveningen","f":[["El arenque nuevo","Hollandse Nieuwe: arenque crudo ligeramente salado, que se come sujetándolo por la cola, a menudo con cebolla cruda."],["Vlaggetjesdag","El tercer sábado de junio, el puerto se engalana para la temporada del arenque, con la subasta del primer barrilito."],["El chapuzón de Año Nuevo","El 1 de enero, baño polar en el mar: 50 000 personas participaron en 2016."],["El Kurhaus","El Kurhaus, hotel de Scheveningen, abrió sus puertas en 1886."]]},"eg-mer-rouge-elgouna":{"n":"El Gouna","f":[["El koshari","Mezcla de arroz, lentejas y macarrones, vendida en la calle; algunos lo consideran el plato nacional egipcio."],["El té","El té es la bebida nacional de Egipto, a menudo servido con menta."],["El festival de cine de El Gouna","Cada octubre, la ciudad turística acoge un festival de cine creado en 2017."],["Al-Gouna, la laguna","El nombre árabe de El Gouna significa «la laguna»: la ciudad se extiende sobre 20 islas rodeadas de lagunas."]]},"ky-grandcayman-stingray":{"n":"Stingray City y Gran Caimán","f":[["El lambi","El lambi se prepara marinado, en ensalada, en sopa o en guiso; es un plato básico de las islas Caimán desde hace mucho tiempo."],["La Pirates Week","En noviembre, recreaciones de invasiones piratas, gran desfile cultural y carrera de barcos de cartón (del 8 al 22 de nov. en 2025)."],["Las rayas de Stingray City","Las rayas se habrían reunido cuando los pescadores limpiaban sus capturas en los bajíos, y luego asociaron el motor con la comida."]]},"ve-losroques":{"n":"Los Roques","f":[["La arepa","La arepa, torta de maíz, se come a cualquier hora en Venezuela; la «reina pepiada» lleva pollo, aguacate y mayonesa."],["El Festival de la Langosta","En noviembre, con la apertura de la temporada de pesca, el archipiélago celebra la langosta espinosa, uno de sus animales emblemáticos."],["La Virgen del Valle","La segunda semana de septiembre, una procesión de barcos sale de Crasquí hacia Gran Roque: la Virgen protege a los pescadores."],["Gran Roque","Casi todos los habitantes viven en Gran Roque, un pequeño pueblo de siete calles de arena."]]},"fj-vitilevu-beqa":{"n":"Laguna de Beqa","f":[["El kokoda","Pescado crudo marinado en limón y leche de coco, con verduras en dados (pepino, tomate, cebolla)."],["El lovo","El lovo es el horno de tierra fiyiano: piedras calientes en un foso, comida cubierta de tierra, para las grandes ocasiones."],["La marcha sobre el fuego","Cinco pueblos de Beqa son famosos por la marcha sobre el fuego (vilavilairevo), ya una atracción turística en 1902."],["El Hibiscus Festival","A finales de agosto y principios de septiembre, Suva elige reinas y ofrece programas culturales (del 31 de agosto al 7 de sept. en 2024)."]]},"to-vavau":{"n":"Vavaʻu","f":[["La cocina tradicional","La dieta tradicional se basa en el taro, el ñame, el plátano, el coco y el pescado cocido en hojas."],["El domingo tongano","El sabbat está inscrito en la constitución: el domingo, comercios y diversiones se detienen."],["El horno de tierra umu","Antiguamente, la gran comida del mediodía se cocía en un horno de tierra; también se preparaba allí el cerdo de las bodas y de los duelos."],["El puerto de Neiafu","Neiafu, capital de Vavaʻu, es un puerto abrigado; de mayo a octubre acoge veleros llegados de todo el mundo."]]},"yt-mayotte-ngouja":{"n":"N’Gouja y Kani-Kéli","f":[["El mataba","Hojas de mandioca estofadas en leche de coco, un plato largo de preparar que se sirve sobre todo en las ceremonias."],["La chahoula ya nadzi","Arroz cocido en agua o en leche de coco, plato obligado de las ceremonias (circuncisión, debbah, maoulida) y de las grandes comidas familiares."],["El maoulida shengué","Canto tradicional que mezcla canto, danza y coreografía, inscrito en el patrimonio cultural inmaterial nacional desde junio de 2022."],["La salouva","Las mujeres suelen llevar la salouva, una prenda colorida; los hombres, ropa de algodón blanco."],["El kibushi","Lengua de origen malgache, el kibushi es la lengua materna de alrededor del 30 % de los habitantes de Mayotte."]]},"no-jaeren-borestranda":{"n":"Jæren y Borestranda","f":[["El Jædersylte","Producto local del Jæren: carne y tocino picados, luego envasados en conserva."],["Gladmat","A finales de junio, en Stavanger, el mayor festival culinario de Noruega: productores locales en el puerto (del 23 al 26 de junio de 2027)."],["La Jærdagen","El último fin de semana de mayo, Bryne celebra la Jærdagen, su fiesta de la ciudad."],["El derecho de acceso a la naturaleza","Cualquiera puede recorrer las tierras no cultivadas, acampar a 150 m como mínimo de una casa y recoger bayas."],["El jærsk","Allí se habla el jærsk, un dialecto del suroeste de Noruega, sobre todo en Hå, Time y Klepp."]]},"se-bohuslan-kosterhavet":{"n":"Kosterhavet y Strömstad","f":[["Mariscadas y fiestas de camarones","En Strömstad, los restaurantes sirven mariscadas y fiestas de camarones durante Smaka på Bohuslän."],["La apertura de la pesca de la langosta","El primer lunes después del 20 de septiembre, a las 7 h en punto, se abre la caza de la langosta; dura hasta el 30 de noviembre."],["Smaka på Bohuslän","A principios de octubre, Strömstad celebra los sabores de Bohuslän: mariscos, pesca de langosta, visitas a granjas (del 2 al 11 de oct.)."],["El allemansrätten","El derecho de acceso público permite caminar, acampar una o dos noches y recoger bayas y setas fuera de los cultivos."],["Las ostras del propietario","Las ostras pertenecen al propietario del terreno: no se recogen donde uno quiera."]]},"dk-jutland-hvidesande":{"n":"Hvide Sande","f":[["Las platijas secas","Las platijas secas (dabs) son la golosina local de Hvide Sande, que se prueba gratis durante la fiesta de los Æ Dabs."],["Æ Dabs Day","En la Ascensión, se cierra la calle Metheasvej para probar platijas secas, con música y tiendas abiertas."],["El festival del arenque","A finales de abril: arenque ahumado bajo la carpa, concurso de pesca y música (del 23 al 25 de abril de 2027)."],["Waterz","A principios de septiembre, el mayor festival náutico de Escandinavia: windsurf, kitesurf, surf, SUP (el 3 y 4 de sept. de 2027)."],["La subasta del domingo","Todos los domingos de julio y agosto, y un domingo de octubre, se puja por la pesca del día en la lonja."]]},"ie-sligo-easkey":{"n":"Easkey","f":[["Los productos de Sligo","El condado de Sligo destaca las ostras de Lissadell, la langosta salvaje de Mullaghmore y la miel de Knocknarea."],["Los baños de algas","Los baños de algas, surgidos en la era victoriana, sobreviven en Enniscrone: la casa Kilcullen data de 1912."],["El Poll Gorm","Piscina natural de agua salada cuyo muro construyeron en 1966 cuatro vecinos; los niños del lugar aprenden allí a nadar."],["Iascaigh","Iascaigh, el nombre irlandés de Easkey, significa «rica en peces»."]]},"ec-galapagos-puntacarola":{"n":"San Cristóbal","f":[["El ceviche de canchalagua","El ceviche de canchalagua es típico sobre todo de San Cristóbal, la isla más oriental del archipiélago."],["La cantonización","El 18 de febrero, Puerto Baquerizo Moreno celebra la cantonización, su fiesta mayor."],["La distancia con los animales","En el parque nacional, mantente a 2 m como mínimo de los animales, aunque se acerquen, sin alimentarlos ni salir de los senderos."],["La Lobería","Esta colonia de lobos marinos está a diez minutos en autobús de Puerto Baquerizo Moreno."],["La estatua de Darwin","Una estatua marca el lugar donde Darwin desembarcó por primera vez en las Galápagos, el 16 de septiembre de 1835."]]},"vi-saintjohn-trunkbay":{"n":"Trunk Bay y Saint John","f":[["El fungi","Polenta de maíz con okra, servida con pescado hervido o bacalao salado."],["El kallaloo","Sopa de hojas de callaloo, a veces sustituidas por espinacas."],["La St. John Celebration","Del 14 de junio al 4 de julio de 2026: desfile del 4 de Julio, steel bands, concursos de cocina y fuegos artificiales en Cruz Bay."],["El J’ouvert","El J’ouvert («amanecer»): al alba se baila al ritmo de soca y calipso, cubierto de barro, polvo y pintura."],["El sendero submarino","El sendero bordea Trunk Bay Cay a lo largo de unos 90 m (300 pies) y sus placas ayudan a los principiantes a reconocer la vida marina."]]},"fr-paysbasque-cotebasque":{"n":"Biarritz, Anglet y San Juan de Luz","f":[["El gâteau basque","Masa quebrada rellena de cerezas negras o de crema pastelera: el «bizcocho de la casa» (etxeko biskotxa), que se sirve en los días de fiesta."],["La roca de la Virgen","Promontorio con forma de casco de barco, coronado por una estatua de la Virgen: el emblema de Biarritz, con vistas a la bahía y a los Pirineos."],["El ttoro de San Juan de Luz","La sopa de los pescadores de San Juan de Luz, Ciboure y Socoa, hecha en origen con el pescado sin vender: merluza, crustáceos y mariscos."],["El macaron de San Juan de Luz","Un pastelero llamado Adam se los habría ofrecido a Luis XIV en su boda de 1660, y sus descendientes mantienen la tradición."],["La casa de la Infanta","Casa de ladrillo rosa y piedra (hacia 1640) en el puerto, donde fue recibida la infanta María Teresa para casarse con Luis XIV, en 1660."]]},"fr-gironde-lacanau":{"n":"Lacanau","f":[["El Lacanau Pro","La competición profesional de surf más antigua de Francia, nacida en 1979 en el Lacanau Surf Club, se celebra cada año en agosto."],["El cannelé","Pastelito bordelés con ron y vainilla, cocido en un molde acanalado, antes de cobre, que le da una fina corteza caramelizada."],["El lago de Lacanau","Con casi 2.000 hectáreas, uno de los grandes lagos de las Landas; el canal des Étangs lo une a Hourtin al norte y a la cuenca de Arcachon al sur."],["El paralelo 45","Lacanau está en el paralelo 45 norte: a medio camino entre el polo Norte y el ecuador, a unos 5.000 km de cada uno."]]},"fr-morbihan-belleile":{"n":"Belle-Île-en-Mer, costa salvaje","f":[["Las agujas de Port-Coton","Estas rocas de la costa salvaje deben su nombre a la espuma que, con mucho oleaje, parece un velo de algodón. Monet las pintó en 1886."],["Los acadianos de Belle-Île","A partir de 1765, 78 familias acadianas expulsadas en la «gran deportación» de 1755 se instalaron en la isla."],["El cordero del mar abierto","La etiqueta «Agneau du large», creada en 1994, certifica un cordero nacido en la isla que ha pasado al menos 60 días en el prado."],["El bosque del Génie","Este bosque se plantó alrededor de las fortificaciones de Vauban para ocultarlas y protegerlas; su nombre viene del cuerpo de ingenieros militares que lo decidió."]]},"fr-bretagne-saintmalo":{"n":"Saint-Malo","f":[["La Route du Rhum","Regata en solitario entre Saint-Malo y Guadalupe, cada cuatro años desde 1978, de finales de octubre a principios de noviembre."],["El Grand Bé","Isla deshabitada al pie de las murallas, a la que se llega a pie con la marea baja: allí está enterrado Chateaubriand, según su deseo."],["La ciudad de los corsarios","Antigua ciudad de corsarios, Saint-Malo vio nacer a capitanes como Duguay-Trouin y Surcouf; sus habitantes son los malouinos."],["Las ostras planas de Cancale","A quince kilómetros al este, Cancale es famosa por sus ostras planas salvajes, de bancos naturales en aguas profundas."]]},"fr-normandie-etretat":{"n":"Étretat","f":[["Los acantilados y los tres arcos","Acantilados de creta con tres arcos: la porte d’Amont, la porte d’Aval y la Manneporte, que un río subterráneo habría excavado primero."],["La Aguja hueca","Maurice Leblanc, que vivía en Étretat, hizo de la Aguja el escondite de Arsène Lupin en su novela «La Aguja hueca» (1909)."],["Los pintores de Étretat","Monet, Courbet, Boudin o Marquet pintaron aquí el carácter del lugar, ora sereno ora violento, y forjaron su fama."],["Las fiestas de Offenbach y Maupassant","En el siglo XIX, artistas como Offenbach o Maupassant daban aquí fiestas para sus amigos, cuando el balneario se ponía de moda."]]},"fr-provence-calanques":{"n":"Calanques de Marsella y de Cassis","f":[["La bullabesa","Sopa de pescado emblemática de Marsella, servida con costrones frotados con ajo y untados de rouille, trozos de pescado y patatas."],["El Parque Nacional de las Calanques","Creado en abril de 2012, es el primer parque nacional periurbano de Europa y el tercero del mundo."],["Calanque","La palabra viene del provenzal calanco: un valle excavado por un río y luego invadido por el mar."],["El vino de Cassis","El cassis es un vino con denominación de origen, la primera AOC reconocida en Provenza, en 1936; se hace blanco y rosado."]]},"fr-var-pampelonne":{"n":"Pampelonne y Saint-Tropez","f":[["La tarte tropézienne","Brioche partida en dos y rellena de crema pastelera y crema de mantequilla; la receta original del pastelero Alexandre Micka es secreta."],["La bravade de mayo","El 16 de mayo, el alcalde entrega la pica al Capitán de la Ciudad elegido el lunes de Pascua; marineros y mosqueteros disparan salvas y se bendicen las armas."],["La bravade del 15 de junio","El 15 de junio de 1637, los tropezianos vencieron a 21 galeras españolas, una victoria que desde entonces se celebra con una bravade."],["La playa de Pampelonne","Playa de arena de 4,5 km y 27 hectáreas, en el municipio de Ramatuelle y no en Saint-Tropez, en el dominio público marítimo del Estado."]]},"gp-basseterre-cousteau":{"n":"Reserva Cousteau y costa a sotavento","f":[["La reserva Cousteau","Reserva marina de unas 400 hectáreas alrededor de los islotes Pigeon, frente a la playa de Malendure: protege los fondos y limita la pesca."],["El gwoka","Música de Guadalupe que se toca sobre todo con tambores «ka»: el más grande lleva el ritmo y el más pequeño sigue a los bailarines y cantantes."],["El carnaval de Guadalupe","De enero al miércoles de Ceniza: gran desfile en Pointe-à-Pitre el Domingo Gordo y, el último día, se quema a Vaval, rey del carnaval."],["El ti-punch","Ron, lima y sirope de caña: este pequeño cóctel habría nacido en Marie-Galante y forma parte de la vida social de las Antillas."]]},"mq-anses-darlet-dufour":{"n":"Anse Dufour y Les Anses-d’Arlet","f":[["Dos calas, dos arenas","Anse Dufour tiene arena blanca y su vecina Anse Noire, arena negra volcánica, la única playa de arena negra del sur de Martinica."],["La iglesia de Saint-Henri","Junto a la playa, uno de los lugares más bonitos de Martinica por su alineación con el embarcadero; restaurada en 2008 tras el huracán Dean."],["El féroce de aguacate","Aguacate machacado con bacalao salado desmenuzado y guindilla: su nombre viene de la guindilla. Se sirve sobre todo de aperitivo o de entrante."],["El madrás","Tela a cuadros venida de Madrás, en la India, convertida en tocado criollo en las Antillas; Josefina de Beauharnais habría lanzado la moda."]]},"pt-leiria-nazare":{"n":"Nazaré","f":[["Las siete enaguas","Siete faldas, dice la tradición. Una explicación discutida: mientras esperaban a los pescadores, se protegían del rocío bajo las de arriba."],["La fiesta de Nuestra Señora de Nazaré","El 8 de septiembre, festivo, cae durante diez días de fiesta: procesiones, fuegos artificiales, bailes, feria y corridas de toros."],["El funicular del Sítio","Tres barrios: Praia, junto a la playa, el Sítio, el casco viejo del acantilado, y Pederneira; un funicular une la playa con el Sítio."],["La ola más grande surfeada","En 2020, el alemán Sebastian Steudtner surfeó en Nazaré una ola medida en 26,2 metros, la más grande jamás surfeada."]]},"pt-peniche":{"n":"Peniche y Baleal","f":[["Los encajes de bolillos","Los encajes de Peniche (rendas de bilros) recibieron una medalla de plata en las exposiciones internacionales de París y Londres en 1851."],["La fortaleza de Peniche","Esta fortaleza fue prisión política bajo el Estado Novo; hoy alberga un museo dedicado a la resistencia contra ese régimen."],["Un gran puerto pesquero","Gran puerto pesquero de Portugal, con astilleros y conserveras; la ciudad está en parte rodeada de murallas del siglo XVI."],["El archipiélago de las Berlengas","Frente a Peniche se han encontrado barras de ancla de plomo (2,5 m, 420 kg); una data de finales del siglo V antes de nuestra era."]]},"pt-madere-jardimdomar":{"n":"Madeira, costa suroeste","f":[["La poncha","Bebida de Madeira: aguardiente de caña, miel, limón o naranja. Su nombre viene de una palabra que significa «cinco», como los ingredientes de origen."],["El bolo do caco","Pan redondo y plano cocido sobre una losa de basalto, el «caco», en Madeira y Porto Santo; se sirve con mantequilla de ajo o en bocadillo."],["Las malasadas del carnaval","Dulce de la isla que se come sobre todo durante el carnaval de Madeira."],["El vino de Madeira","Comerciantes ingleses instalados en Funchal desde el siglo XVII controlaron el comercio del vino; la casa Blandy’s data de 1811."]]},"es-paysbasque-guipuzcoa-biscaye":{"n":"Mundaka, Zarautz y San Sebastián","f":[["La Tamborrada","El 20 de enero en San Sebastián se iza la bandera a medianoche y la fiesta dura 24 horas: cocineros y soldados desfilan tocando el tambor."],["Los pintxos","Pequeños bocados para pinchar («pintxo» significa espina), que se comen en bares y tabernas; muy populares en todo el País Vasco."],["El txakoli de Getaria","Vino blanco muy pálido, de amarillo a verde, producido en torno a Getaria, Zarautz y Aia: el primer txakoli con denominación de origen."],["La ría de Urdaibai","La ría de Mundaka, llamada también ría de Gernika, es una reserva de la biosfera de 220 km² en la costa vasca."]]},"es-andalousie-tarifa":{"n":"Tarifa y Bolonia","f":[["Levante y Poniente","El estrecho de Gibraltar, en Tarifa, acelera los vientos del este (Levante) y del oeste (Poniente): más de 10 nudos de media."],["El castillo de Guzmán","Bien conservado junto al puerto, lo mandó construir hacia 960 el califa Abderramán III; le está adosada la torre de Guzmán el Bueno (siglo XIII)."],["La pesca de almadraba","Antiguas trampas de redes para el atún rojo, que entra en el Mediterráneo de febrero a julio; Tarifa figura entre los puertos de almadrabas."],["Baelo Claudia","En Bolonia, a 22 km de Tarifa, la ciudad romana vivía del atún, la salazón y el garum; el emperador Claudio la hizo municipio."]]},"es-canaries-lanzarote":{"n":"Famara y La Santa, Lanzarote","f":[["Las papas arrugadas","Patatas hervidas «arrugadas», servidas con mojo rojo; se comen sin cubiertos, de las fuentes compartidas."],["El mojo","Salsa de aceite de oliva, ajo, pimiento picante y especias, nacida en Canarias: verde (mojo verde), roja (mojo rojo) o muy picante (mojo picón)."],["Las viñas de La Geria","En La Geria, la lava del Timanfaya (1730) cubre el suelo: cada cepa se hunde hasta la tierra antigua, protegida del viento por un muro, el zoco."],["César Manrique","El artista César Manrique (nacido en 1919) transformó las cuevas volcánicas de Jameos del Agua en los años 1970, respetando la naturaleza."]]},"gb-cornwall-fistral":{"n":"Fistral y Newquay","f":[["El Cornish pasty","Empanadilla de masa rizada, rellena de ternera, patata, nabo sueco y cebolla; tiene indicación geográfica protegida en Europa desde 2011."],["Los Boardmasters","Música, surf y skate en Newquay, unos cinco días, el segundo fin de semana de agosto; competición de surf desde 1981, música desde 2005."],["El Huer’s Hut","Pequeña construcción de piedra, quizá del siglo XIV, puesto de vigía en el XVI: el «huer» avisaba de las sardinas y guiaba a los pescadores."],["El saffron bun","Bollo dulce con azafrán, pasas y especias, llamado «revel bun» en Cornualles; en molde grande, es el «saffron cake»."]]},"ie-clare-lahinch":{"n":"Lahinch y el condado de Clare","f":[["Leath Inse","Lahinch viene del irlandés Leath Inse, «media isla» o «península»."],["El golf entre las dunas","El Lahinch Golf Club, fundado en 1892, es un campo de links; en 2024, su Old Course figura en el puesto 27 de los mejores campos del mundo según Golf Digest."],["Los acantilados de Moher","En el mismo condado de Clare, se extienden unos 14 km y alcanzan 214 metros, justo al norte de la torre de O’Brien."],["La escuela de música Willie Clancy","En Milltown Malbay, la mayor escuela de verano de música tradicional del mundo: casi mil alumnos, a principios de julio."]]},"it-campanie-capri":{"n":"Capri","f":[["La fiesta de San Costanzo","El 14 de mayo, la ciudad de Capri celebra a San Costanzo, su santo patrón; Anacapri celebra al suyo, Sant’Antonio, el 13 de junio."],["La insalata caprese","Mozzarella, tomate y albahaca con aceite de oliva; su nombre alude a Capri, donde se cree que nació. Se hizo famosa en los años 1950."],["La Gruta Azul","Cueva marina: el sol entra por una abertura bajo el agua y hace brillar el agua con un azul luminoso; se adentra 50 m en el acantilado."],["El limoncello","Licor de cáscara de limón, elaborado sobre todo en torno al golfo de Nápoles; se sirve bien frío como digestivo."]]},"gr-cyclades-milos":{"n":"Milos","f":[["La Venus de Milo","La estatua fue descubierta en 1820 en la isla de Milos y se expone en el Louvre, en París, desde 1821."],["La obsidiana de Milos","Desde el Heládico antiguo, la isla vendía obsidiana a gran parte de la Grecia continental, a Chipre, a Creta y a Egipto."],["Phylakopi","Uno de los yacimientos más importantes del mundo egeo para la Edad del Bronce antigua; Milos era un gran centro económico de los minoicos."],["Las esculturas de Milos","La isla dio el Poseidón de Milos (en Atenas), el Asclepio de Milos (en el British Museum) y un Apolo arcaico, además de la Venus."]]},"gr-crete-balos":{"n":"Balos y la bahía de Kissamos","f":[["El dakos","Ensalada cretense: pan duro (paximadi) remojado, tomates, feta o mizithra y hierbas como el orégano; se le añaden aceitunas y alcaparras."],["La tsikoudia","Aguardiente de orujo de uva de origen cretense, de 40 a 65 % de alcohol; en el este de Creta suele llamarse raki."],["El paximadi","Pan duro de trigo integral, garbanzo o cebada, parecido a una tostada; suele servirse en el desayuno con mermelada o queso."],["Imeri Gramvousa","La isla vecina conserva un fuerte veneciano y los edificios de insurgentes cretenses que vivieron allí como piratas durante la guerra de independencia griega."]]},"hr-dalmatie-brac":{"n":"Bol y la isla de Brač","f":[["El Zlatni Rat","Lengua de guijarros blancos a 2 km al oeste del puerto de Bol. Su punta se desplaza con el viento y las corrientes, a veces en pocas horas."],["La piedra blanca de Brač","La caliza blanca de la isla, extraída desde hace milenios, sirvió para construir el palacio de Diocleciano en Split (295 a 305) y el memorial de Vimy."],["La cueva de Kopačina","Entre Supetar y Donji Humac, una cueva con huellas humanas del XII milenio antes de nuestra era, entre las más antiguas de Dalmacia."],["El aceite de oliva de Brač","Se cultiva el olivo en la isla desde la época romana, y su aceite goza hoy de una denominación de origen protegida."]]},"ma-souss-agadir-taghazout":{"n":"Taghazout, Anchor Point y Agadir","f":[["El aceite de argán","En Marruecos se moja el pan en él en el desayuno o se echa un chorrito sobre el cuscús; el argán es originario de Marruecos y del suroeste de Argelia."],["El amlou","Crema para untar de almendras tostadas machacadas, miel y aceite de argán, que se sirve en el desayuno o la merienda con crepes y pasteles."],["El té a la menta","La bebida más popular de Marruecos, el atay: preparar un buen té a la menta se considera un arte."],["Agadir, reconstruida","Destruida por un terremoto en 1960, la ciudad se reconstruyó con normas antisísmicas; es el mayor balneario de Marruecos."]]},"ma-essaouira-sidikaouki":{"n":"Essaouira y Sidi Kaouki","f":[["El festival Gnaoua","Fundado en 1998, este festival anual reúne en Essaouira a músicos gnaua de Marruecos y a artistas invitados de todo el mundo."],["La madera de tuya","La marquetería de tuya es la artesanía que más hace vivir a Essaouira: en 2011, el 58 % de los artesanos de la ciudad trabajaba esta madera."],["Los vientos de la bahía","Vientos potentes casi todo el tiempo en la bahía: lugar famoso de windsurf y kitesurf, con una etapa de la copa del mundo."],["Sidi Kaouki","A 25 km al sur de Essaouira, esta pequeña ciudad es un lugar de windsurf gracias a vientos fuertes y regulares y a un oleaje moderado."]]},"cv-sal":{"n":"Isla de Sal","f":[["La cachupa","Plato nacional de Cabo Verde: guiso de maíz, alubias y pescado o carne; las sobras se refríen para el desayuno con un huevo."],["Sal, «la sal»","Descubierta el 3 de diciembre de 1460, la isla se llamaba Chã («llana»); pasó a ser Sal al hallarse en ella dos grandes salinas."],["El grogue y el ponche","El grogue es un aguardiente de jugo de caña de azúcar, popular en Cabo Verde; es la base del ponche, una especie de ponche."],["El pastel","Pequeña empanadilla frita rellena de pescado o de carne, que se sirve de entrante en Cabo Verde."]]},"sc-ladigue-praslin":{"n":"La Digue y Praslin","f":[["La carreta de bueyes","En La Digue se alquilan bicicletas cerca del muelle; el otro medio de transporte es la carreta de bueyes, cuyo paso lento va con la isla."],["El Valle de Mai","Bosque de palmeras de 19,5 hectáreas en Praslin, inscrito por la UNESCO en 1983; alberga el coco de mar y otras cinco palmeras endémicas."],["El moutya","Danza africana próxima al séga: se sigue un tambor de piel de cabra calentado al fuego antes de empezar; el ritmo es lento y luego se acelera."],["La cocina de pescado","El pescado tiene aquí cientos de recetas: al curry, crudo con limón, a la parrilla o al vapor; también pulpo frito y langosta al ajo."]]},"us-hawaii-oahu":{"n":"Oahu: North Shore y Waikiki","f":[["Eddie Aikau","El Eddie Aikau Big Wave Invitational, «The Eddie», lleva su nombre; murió en 1978 durante el viaje de la canoa Hōkūleʻa."],["Duke Kahanamoku","Nacido bajo el Reino de Hawái, este nadador tuvo el récord mundial de los 100 m libres y ganó cinco medallas olímpicas (1912, 1920, 1924)."],["Lei Day","El 1 de mayo, fiesta del lei, oficial desde 1929; cada isla tiene su flor, la ilima amarilla para Oahu. Gran ceremonia en el parque Kapiʻolani."],["El plate lunch","Comida típica de Hawái: una o dos bolas de arroz, ensalada de macarrones y un plato a menudo japonés, como el pollo katsu."]]},"cr-nicoya":{"n":"Península de Nicoya","f":[["El gallo pinto","«Gallo pinto» en español: arroz y frijoles cocinados con ajo, orégano y cebolla. Plato nacional de Costa Rica y de Nicaragua."],["Una zona azul","Nicoya figura entre las «zonas azules» (longevidad fuera de lo común). El concepto no está probado: los nacidos después de 1930 no viven más años."],["Los chorotegas","Antes de la llegada de los españoles, el pueblo chorotega vivía aquí, en ciudades como Zapatí, Nacaome o Nicopasaya."],["El refugio de Ostional","Refugio de 85,7 km², protegido desde 1982, con playas de anidación de la tortuga golfina: según el WWF, uno de los dos sitios principales del mundo."]]},"id-bali-bukit":{"n":"Uluwatu y Padang Padang","f":[["El templo de Uluwatu","Construido al borde (ulu) de un acantilado (watu) de 70 m; según la leyenda, esta roca es parte de la barca petrificada de la diosa Dewi Danu."],["El kecak","Danza cantada por un coro de hombres, que se representa cada día a las 18 h en templos balineses como Uluwatu y Tanah Lot."],["Melasti","Antes de Nyepi, los hindúes balineses van al mar para purificarse: arrojan simbólicamente el mal pasado y lavan los objetos sagrados de sus templos."],["Nyepi, el día del silencio","El año nuevo balinés: silencio, ayuno y meditación. Nadie, turistas incluidos, va a las playas ni a las calles; el aeropuerto cierra."]]},"nz-raglan":{"n":"Raglan","f":[["Waikeri","El nombre tradicional de Manu Bay es Waikeri, «aguas que giran»; este spot de surf aparece en la película The Endless Summer (1966)."],["La película The Endless Summer","Documental de Bruce Brown (1966): los surfistas californianos Mike Hynson y Robert August dan la vuelta al mundo, con parada en Manu Bay."],["El hāngī","Cocción maorí en un horno de tierra (umu): se calientan piedras y luego se entierra la comida; aún se usa en las grandes ocasiones."],["El monte Karioi","Volcán extinto de 2,4 millones de años, a 8 km al suroeste de Raglan, el primero de seis volcanes alineados, el mayor de los cuales es el Pirongia."]]},"jp-kanagawa-shonan":{"n":"Shonan, Kamakura y Enoshima","f":[["El gran Buda de Kamakura","Estatua de bronce de 13,35 m y unas 93 toneladas, fechada hacia 1252 en los archivos del templo; es hueca y se visita por dentro."],["El yabusame","Tiro con arco a caballo: el arquero lanza tres flechas a tres blancos de madera. Se ve en el santuario Tsurugaoka Hachiman-gū, en Kamakura."],["La isla de Enoshima","Unida por un puente de 389 m, la isla está dedicada a Benzaiten, diosa de la música, que la habría hecho surgir del mar en el siglo VI."],["Kamakura, capital de los shogunes","En 1192, el shogun Minamoto no Yoritomo hizo de Kamakura, entonces un simple pueblo, su capital; su gobierno dominó el país hasta 1333."]]},"br-santacatarina-floripa":{"n":"Joaquina, Praia Mole y la isla de Santa Catarina","f":[["La herencia azoriana","A mediados del siglo XVIII, miles de azorianos migraron aquí; Florianópolis conserva su huella: casas, artesanía, cocina."],["Las ostras de Ribeirão da Ilha","Este distrito de Florianópolis, uno de los primeros núcleos de colonización azoriana, es el mayor productor de ostras de Brasil."],["Joaquina y sus dunas","La playa, muy apreciada por los surfistas por la calidad de sus olas, está rodeada por el parque natural municipal de las dunas de la Lagoa da Conceição."],["Praia Mole","Playa de 960 metros en la costa este de la isla, conocida por atraer a jóvenes, surfistas y parapentistas."]]}}};
