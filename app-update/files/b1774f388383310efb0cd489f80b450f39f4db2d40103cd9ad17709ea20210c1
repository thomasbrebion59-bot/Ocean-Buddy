/* Ocean Buddy 1.3 — accueil « envies de départ » (home-feed.js). */
#home.hf-on .home-intro{display:none!important}
#home.hf-on #oceanHub .hub-greet{display:none}
#home.hf-on #oceanHub{margin-top:14px}

/* ---------- Ouverture : recherche, activités, spots de rêve ---------- */
.hf-top{margin:0 0 4px}
.hf-search{display:flex;align-items:center;gap:12px;width:100%;min-height:60px;margin:0 0 12px;padding:8px 18px;border:0;border-radius:999px;cursor:pointer;text-align:left;
  background:#fff;color:var(--as-ink,#0c1d3f);box-shadow:0 10px 30px -14px rgba(12,29,63,.45),0 1px 2px rgba(12,29,63,.06)}
.hf-search svg{width:22px;height:22px;flex:none;color:var(--as-accent,#1f55e0)}
.hf-search span{display:grid;gap:1px;min-width:0}
.hf-search b{font:750 16px/1.2 var(--body)}
.hf-search small{font:500 13px/1.25 var(--body);color:var(--as-ink3,#7d8aa6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hf-search:active{transform:scale(.98)}
.hf-acts{display:flex;gap:8px;overflow-x:auto;margin:0 calc(-1 * var(--as-gutter,16px)) 14px;padding:2px var(--as-gutter,16px) 4px;scrollbar-width:none;scroll-snap-type:x proximity}
.hf-acts::-webkit-scrollbar{display:none}
.hf-act{flex:none;display:inline-flex;align-items:center;gap:7px;height:44px;padding:0 15px 0 5px;border:1px solid rgba(12,29,63,.08);border-radius:999px;background:#fff;color:var(--as-ink,#0c1d3f);font:700 14px var(--body);cursor:pointer;scroll-snap-align:start;box-shadow:0 4px 12px -8px rgba(12,29,63,.4)}
.hf-act .hf-act-ic,.hf-act img,.hf-act svg{width:34px;height:34px;border-radius:50%;object-fit:cover;flex:none}
.hf-act:active{transform:scale(.96)}
/* Pictogramme fixe (34 px) : la taille ne dépend plus des règles génériques, les chips ne bougent plus. */
.hf-act .poulpy-mini,.hf-act img.hf-act-ic{width:34px!important;height:34px!important;min-width:34px;max-width:34px;flex:0 0 34px;padding:0!important;margin:0!important;border-radius:50%;background:#EAF2FF;object-fit:contain;box-shadow:none!important;filter:none!important}
.hf-hero{position:relative;overflow:hidden;isolation:isolate;border-radius:var(--as-r-xl,28px);background:#0b2d7a;aspect-ratio:4/5;min-height:430px;max-height:600px;box-shadow:0 26px 60px -30px rgba(12,29,63,.75)}
.hf-slides{position:absolute;inset:0;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.hf-slides::-webkit-scrollbar{display:none}
.hf-slide{position:relative;flex:0 0 100%;height:100%;scroll-snap-align:start;scroll-snap-stop:always;cursor:pointer;color:#fff;overflow:hidden}
.hf-slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 62%;z-index:-2;transform:scale(1.04);transition:transform 6s ease-out}
.hf-slide::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,10,30,.25) 0%,rgba(0,10,30,0) 28%,rgba(0,10,30,0) 48%,rgba(0,12,36,.82) 100%)}
.hf-slide-tx{position:absolute;left:20px;right:20px;bottom:38px}
.hf-kicker{display:inline-block;padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);font:750 11.5px/1 var(--body);letter-spacing:1.2px;text-transform:uppercase;color:#fff}
.hf-slide h2{margin:10px 0 4px;font:900 48px/.92 var(--as-condensed);letter-spacing:-.8px;text-transform:uppercase;color:#fff;text-shadow:0 4px 24px rgba(0,0,0,.4)}
.hf-slide p{margin:0 0 14px;font:600 15px/1.35 var(--body);color:rgba(255,255,255,.9)}
.hf-go{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:999px;background:#fff;color:#0c1d3f;font:800 15px var(--body);cursor:pointer;box-shadow:0 10px 26px -10px rgba(0,0,0,.55)}
.hf-go svg{width:18px;height:18px;color:var(--as-accent,#1f55e0)}
.hf-go:active{transform:scale(.96)}
.hf-dots{position:absolute;left:0;right:0;bottom:16px;display:flex;justify-content:center;gap:6px;pointer-events:none}
.hf-dots i{width:6px;height:6px;border-radius:999px;background:rgba(255,255,255,.5);transition:width .3s,background .3s}
.hf-dots i.on{width:20px;background:#fff}
@media(min-width:960px){.hf-hero{aspect-ratio:auto;height:520px;max-height:none}.hf-slide h2{font-size:76px}.hf-slide-tx{left:44px;bottom:48px;max-width:640px}.hf-acts{margin-inline:0;padding-inline:0}.hf-search{max-width:640px}}

/* ---------- Carte du monde ---------- */
.hf-world{margin:30px 0 4px;border-radius:var(--as-r-xl,28px);overflow:hidden;background:#1b4fc4;color:#fff}
.hf-world-map{position:relative;aspect-ratio:1200/473;background:#0a1d4a}
.hf-world-map img,.hf-world-map canvas{position:absolute;inset:0;width:100%;height:100%}
.hf-world-map img{object-fit:cover}
.hf-world-tx{padding:16px 18px 18px}
.hf-world-tx .hf-kicker{background:rgba(224,255,145,.16);color:var(--ob-lime,#e0ff91)}
.hf-world-tx h2{margin:10px 0 6px;font:900 32px/.95 var(--as-condensed);text-transform:uppercase;letter-spacing:-.3px}
.hf-world-tx p{margin:0 0 14px;font:500 14.5px/1.45 var(--body);color:rgba(255,255,255,.85)}
.hf-world-go{display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 18px;border:0;border-radius:999px;background:var(--ob-lime,#e0ff91);color:#0b2d7a;font:800 15px var(--body);cursor:pointer}
.hf-world-go svg{width:18px;height:18px}

/* ---------- Rails de photos ---------- */
.hf-sec{margin:0}
.hf-sec .as-sec{margin-top:30px}
.hf-rail{display:flex;gap:12px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:var(--as-gutter,16px);
  margin:0 calc(-1 * var(--as-gutter,16px));padding:2px var(--as-gutter,16px) 10px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.hf-rail::-webkit-scrollbar{display:none}
.hf-card{position:relative;flex:0 0 58%;max-width:230px;aspect-ratio:4/5;scroll-snap-align:start;overflow:hidden;isolation:isolate;border-radius:var(--as-r-l,22px);background:#0b2d7a;color:#fff;cursor:pointer;
  box-shadow:0 14px 30px -18px rgba(12,29,63,.6);transition:transform .25s cubic-bezier(.32,1.28,.42,1)}
.hf-rail.big .hf-card{flex-basis:78%;max-width:320px;aspect-ratio:3/4}
.hf-card:active{transform:scale(.97)}
.hf-card:focus-visible{outline:3px solid var(--as-accent,#1f55e0);outline-offset:3px}
.hf-card img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}
.hf-card::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,0) 40%,rgba(3,12,32,.82) 100%)}
.hf-card-tx{position:absolute;left:14px;right:14px;bottom:14px}
.hf-card-tx small{display:block;font:700 11.5px/1.2 var(--body);letter-spacing:.8px;text-transform:uppercase;color:rgba(255,255,255,.82);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hf-card-tx h3{margin:4px 0 8px;font:800 24px/1 var(--as-condensed);letter-spacing:-.3px;text-transform:uppercase;color:#fff;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hf-rail.big .hf-card-tx h3{font-size:30px}
.hf-card-tx p{display:flex;flex-wrap:wrap;gap:6px;margin:0}
.hf-card-tx p span{display:inline-flex;align-items:center;height:24px;padding:0 9px;border-radius:999px;background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);font:700 11.5px var(--body);white-space:nowrap}
.hf-card-tx p .hf-season{background:var(--ob-lime,#e0ff91);color:#0c1d3f}
.hf-fav{position:absolute;top:10px;right:10px;display:grid;place-items:center;width:38px;height:38px;padding:0;border:0;border-radius:50%;cursor:pointer;
  background:rgba(10,20,40,.32);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);color:#fff}
.hf-fav svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2}
.hf-fav.on svg{fill:#ff5a6e;stroke:#ff5a6e}
.hf-fav:active{transform:scale(.88)}
@media(min-width:960px){.hf-card{flex-basis:220px}.hf-rail.big .hf-card{flex-basis:280px}.hf-rail{margin:0;padding-inline:0}}
@media(prefers-reduced-motion:reduce){.hf-slide img{transition:none}}

/* ---------- Fond d’ambiance (photo du spot affiché, floutée) ---------- */
#home.hf-on{position:relative;z-index:0}
.hf-ambient{position:absolute;z-index:-1;left:calc(-1 * var(--as-gutter,16px));right:calc(-1 * var(--as-gutter,16px));top:calc(-8px - var(--as-top,0px));height:560px;overflow:hidden;pointer-events:none;
  -webkit-mask-image:linear-gradient(180deg,#000 35%,transparent);mask-image:linear-gradient(180deg,#000 35%,transparent)}
.hf-ambient img{position:absolute;inset:-60px;width:calc(100% + 120px);height:calc(100% + 120px);object-fit:cover;filter:blur(46px) saturate(1.5) brightness(1.08);opacity:0;transition:opacity 1.2s ease}
.hf-ambient img.on{opacity:.55}
@media(min-width:960px){.hf-ambient{left:-24px;right:-24px;top:-24px}}

/* ---------- Envies du moment ---------- */
.hf-moods .as-sec{margin-top:28px}
.hf-mood-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.hf-mood{position:relative;overflow:hidden;isolation:isolate;aspect-ratio:1/1;border:0;border-radius:var(--as-r-l,22px);padding:0;cursor:pointer;color:#fff;text-align:left;background:#0b2d7a;box-shadow:0 12px 26px -16px rgba(12,29,63,.6)}
.hf-mood img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}
.hf-mood::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,0) 35%,rgba(3,12,32,.78))}
.hf-mood b{position:absolute;left:12px;right:10px;bottom:28px;font:800 20px/1 var(--as-condensed);text-transform:uppercase;letter-spacing:-.2px}
.hf-mood small{position:absolute;left:12px;bottom:11px;font:650 12px var(--body);opacity:.85}
.hf-mood:active{transform:scale(.97)}
@media(min-width:960px){.hf-mood-grid{grid-template-columns:repeat(4,1fr)}}
