/* Transition d'activité : un voile uni s'installe, le nom de l'activité apparaît en petit, l'écran change dessous,
   puis le voile se retire. Environ 1 s, opacité et transform seulement, sans illustration ni rideau.
   Un toucher passe directement à la fin. Mouvement réduit : fondu seul. */
(() => {
  'use strict';
  /* Une seule couleur de fond pour toutes les activités ; seule la fine règle change de teinte. */
  const FX={
    surf:{a:'#7FB2FF'},bodyboard:{a:'#8FD0FF'},baignade:{a:'#7FDCEA'},paddle:{a:'#7FE0C8'},kayak:{a:'#B2E37E'},
    snorkeling:{a:'#7FE3DA'},plongee:{a:'#7ACFF0'},kitesurf:{a:'#FF9C86'},windsurf:{a:'#C7A8FF'}
  };
  const EASE='cubic-bezier(.2,0,0,1)';
  const reduced=()=>document.body.classList.contains('reduce-motion')||matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait=ms=>new Promise(r=>setTimeout(r,ms));
  let busy=false;
  function count(id){try{return SPOTS.filter(s=>spotSports(s).includes(id)).length;}catch(_){return 0;}}
  function anim(el,frames,ms,delay=0){
    try{return el.animate(frames,{duration:ms,delay,easing:EASE,fill:'forwards'}).finished.catch(()=>{});}
    catch(_){return Promise.resolve();}
  }
  async function play(id,swap){
    const fx=FX[id];
    if(!fx||busy){swap?.();return;}
    busy=true;
    const sport=(typeof SPORTMAP!=='undefined'&&SPORTMAP[id])||{label:id},n=count(id);
    const el=document.createElement('div');el.className='act-tr';el.dataset.act=id;el.setAttribute('aria-hidden','true');
    el.style.setProperty('--a',fx.a);
    el.innerHTML=`<div class="act-tr-cap"><span class="act-tr-eyebrow">Activité</span><b class="act-tr-title">${sport.label}</b><i class="act-tr-rule"></i>${n?`<small class="act-tr-count">${n} spots</small>`:''}</div>`;
    const live=document.getElementById('a11yLive');if(live)live.textContent=`${sport.label} : ${n} spots`;
    document.body.append(el);
    let skip=false;el.addEventListener('pointerdown',()=>{skip=true;},{once:true});
    const cap=el.querySelector('.act-tr-cap'),rule=el.querySelector('.act-tr-rule');
    const calm=reduced();
    /* 1. le voile monte en fondu, 2. l’écran change dessous, 3. le nom apparaît, 4. le voile se retire. */
    await anim(el,[{opacity:0},{opacity:1}],skip?0:(calm?180:200));
    try{swap?.();}catch(e){console.error(e);}
    try{navigator.vibrate?.(6);}catch(_){}
    if(!calm){
      anim(cap,[{opacity:0,transform:'translate3d(0,8px,0)'},{opacity:1,transform:'none'}],260);
      anim(rule,[{transform:'scaleX(0)'},{transform:'scaleX(1)'}],320,120);
    }else{cap.style.opacity='1';}
    for(let t=0;t<(calm?200:340)&&!skip;t+=40)await wait(40);
    await anim(el,[{opacity:1},{opacity:0}],calm?180:(skip?120:220));
    el.remove();busy=false;
  }
  /* Retour à « toutes les activités » : fondu enchaîné natif (View Transitions) quand le navigateur le permet. */
  function neutral(swap){
    if(reduced()||!document.startViewTransition||busy){swap?.();return;}
    try{document.startViewTransition(()=>swap?.());}catch(_){swap?.();}
  }
  window.OceanTransition={play,neutral,preload:()=>{},FX};
})();
