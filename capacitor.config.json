{
  "appId": "io.github.thomasbrebion59bot.oceanbuddy",
  "appName": "Ocean Buddy",
  "webDir": "mobile/www",
  "backgroundColor": "#FEF9EB",
  "server": {
    "hostname": "oceanbuddy.localhost"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FEF9EB",
    "webContentsDebuggingEnabled": false
  },
  "android": {
    "backgroundColor": "#FEF9EB",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 500,
      "backgroundColor": "#FEF9EB",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "shakeMenu": false
    }
  }
}
