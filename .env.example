# Modèle des variables lues par netlify/functions. Valeurs VIDES : ne jamais y écrire de clé.
# Les vraies valeurs vivent dans les variables d'environnement Netlify (ou un .env local ignoré par git),
# et le développement local doit viser un projet Supabase de développement, jamais la production.

# --- Poulpy (netlify/functions/lib/poulpy-core.mjs) ---
# Clé secrète OpenAI ou de la passerelle Netlify AI Gateway ; serveur uniquement.
OPENAI_API_KEY=
# Adresse de la passerelle compatible OpenAI (Netlify AI Gateway) ; vide = api.openai.com.
OPENAI_BASE_URL=
# Modèle utilisé ; vide avec passerelle = gpt-4.1-mini, vide sans passerelle = service désactivé.
OPENAI_MODEL=
# "true" pour activer sans passerelle, "false" pour couper le service.
POULPY_ENABLED=
# "true" pour autoriser l'outil de recherche web du fournisseur (coût supplémentaire).
POULPY_WEB_SEARCH=
# Origines autorisées (CORS), séparées par des virgules ; vide = liste par défaut du code.
POULPY_ALLOWED_ORIGINS=

# --- Communauté (netlify/functions/lib/community-handler.mjs) ---
# URL du projet Supabase, forme https://<ref>.supabase.co (projet de dev en local).
COMMUNITY_SUPABASE_URL=
# Clé secrète Supabase (sb_secret_…) : contourne RLS, serveur uniquement, jamais côté client.
COMMUNITY_SUPABASE_SECRET_KEY=
# Ancienne clé service_role (JWT), lue seulement si la clé secrète est vide ; serveur uniquement.
COMMUNITY_SUPABASE_SERVICE_ROLE_KEY=
# Clé publique Supabase (sb_publishable_…), utilisée pour vérifier les sessions.
COMMUNITY_SUPABASE_PUBLISHABLE_KEY=
# Ancienne clé anon (JWT public), lue seulement si la clé publique est vide.
COMMUNITY_SUPABASE_ANON_KEY=
# UUID du compte modérateur (seul autorisé à modérer, résoudre les signalements, restreindre).
COMMUNITY_OWNER_ID=
# "true" pour ouvrir la communauté ; toute autre valeur la garde fermée.
COMMUNITY_ENABLED=
# Origines autorisées (CORS), séparées par des virgules ; vide = liste par défaut du code.
COMMUNITY_ALLOWED_ORIGINS=

# --- Build mobile (scripts/build-mobile.cjs), facultatif ---
# Numéro de bundle OTA forcé ; vide = date et heure du build.
OB_BUNDLE_SEQ=
# Adresse HTTPS des mises à jour OTA, terminée par / ; vide = GitHub Pages du projet.
OB_UPDATE_BASE=
